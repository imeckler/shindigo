<main class="page">
{{#if verifiedUser}}

<h1 class="upcoming-events-header">Upcoming events</h1>
{{#each events}}
<div class="upcoming-event">
  <div class="event-details">
    <a href="/{{this.id}}">
      <h2 class="event-name" data-event-id="{{this.id}}">{{this.name}}
      </h2>
    </a>

    <span class="p-datetime">{{{this.displayDate}}}
    </span>
  </div>

  <a href="/{{this.id}}">
    <img class="event-image" src="/events/{{this.image}}" />
  </a>
</div>
{{/each}}

<h1 class="upcoming-events-header">Hosting</h1>
{{#each hostingEvents}}
<div class="upcoming-event">
  <div class="event-details">
    <a href="/{{this.id}}">
      <h2 class="event-name" data-event-id="{{this.id}}">{{this.name}}
      </h2>
    </a>

    <span class="p-datetime">{{{this.displayDate}}}
    </span>
  </div>

  <a href="/{{this.id}}">
    <img class="event-image" src="/events/{{this.image}}" />
  </a>
</div>
{{/each}}
{{else}}

  <h2 class="mb-3 pb-2 text-center">
  <span style="color:indigo; font-size: 3rem; font-family: 'anultra-slab';">shindigo</span>
  is an RSVP app that respects your privacy.
  </h2>

<div class="mb-4" style="display:flex; align-items:center; justify-content: center;">
  <button class="signInHome showVerificationModal button button--primary button--lg" title="Sign in with phone verification">
    <i class="fas fa-sign-in-alt"></i> Sign in or sign up
  </button>
</div>

  {{#if instanceDescription}}
  <!--div class="instance-description mb-4">
    {{{instanceDescription}}}
  </div-->
  {{/if}}

  {{> instanceRules }}


{{/if}}
</main>
